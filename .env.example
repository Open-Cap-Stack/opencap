# OpenCap Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# ZERODB CONFIGURATION (Primary Database)
# ============================================================================
# OpenCap uses ZeroDB as its primary database for all operations
# ZeroDB provides NoSQL tables, PostgreSQL, vector search, and event streaming
# Get your credentials at: https://ainative.studio

# Enable ZeroDB as the primary database
ENABLE_ZERODB=true

# ZeroDB API credentials - required for all database operations
AINATIVE_API_TOKEN=your_ainative_api_token_here
ZERODB_API_KEY=your_zerodb_api_key_here

# ZeroDB API endpoint and project identifier
ZERODB_BASE_URL=https://api.ainative.studio/api/v1
ZERODB_PROJECT_ID=your_project_id_here

# Optional: PostgreSQL connection URL if using ZeroDB PostgreSQL
DATABASE_URL=postgresql://user:password@host:port/database

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3001
NODE_ENV=development

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Configuration
# CRITICAL: Use a strong, randomly generated secret (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_minimum_32_chars
JWT_EXPIRATION=24h

# OAuth Configuration
# Google OAuth - Get credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# LinkedIn OAuth - Get credentials at https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Production User Credentials
# CRITICAL: Set these in production environment BEFORE running createProductionUsers.js
# If not set, script will generate secure random passwords
# NEVER commit actual production passwords to version control
ADMIN_PASSWORD=
TEST_USER_PASSWORD=

# Shortcut API Configuration
SHORTCUT_API_TOKEN=your_shortcut_api_token_here

# API Keys
# CRITICAL: All API keys should be stored as environment variables
# NEVER hardcode API keys in source code
API_KEY=your_api_key_here

# Third-party Service Configuration
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-west-2

# Email Configuration (if applicable)
EMAIL_SERVICE=mailgun
EMAIL_API_KEY=your_email_service_api_key_here
# EMAIL_DOMAIN=mail.your-domain.com
# EMAIL_FROM=noreply@your-domain.com

# Logging
LOG_LEVEL=info


# Rate Limiting Configuration
# Set to 'true' in development to disable rate limiting completely
DISABLE_RATE_LIMIT=true

# Stripe Configuration
STRIPE_SECRET_KEY=
