# OpenCap Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
MONGODB_URI=mongodb://mongo:27017/opencap

# ============================================================================
# ZERODB CONFIGURATION
# ============================================================================
ZERODB_API_KEY=your_zerodb_api_key_here
ZERODB_BASE_URL=https://api.ainative.studio/api/v1
ZERODB_PROJECT_ID=your_project_id_here

# ============================================================================
# BIDIRECTIONAL SYNC CONFIGURATION (GitHub Issue #14)
# ============================================================================

# Sync Orchestrator Settings
ENABLE_SYNC=false
SYNC_DIRECTION=bidirectional
# Options: 'bidirectional', 'mongo-to-zerodb', 'zerodb-to-mongo'

# Sync Performance Settings
SYNC_BATCH_SIZE=100
SYNC_INTERVAL_MS=5000
SYNC_MAX_RETRIES=3
SYNC_RETRY_DELAY_MS=1000

# Circuit Breaker Configuration
SYNC_CIRCUIT_BREAKER_THRESHOLD=5
SYNC_CIRCUIT_BREAKER_RESET_MS=60000

# Health Monitoring
SYNC_HEALTH_CHECK_INTERVAL_MS=30000

# MongoDB Change Stream Settings (MongoDB → ZeroDB)
ENABLE_MONGO_CHANGESTREAM=false
SYNC_COLLECTIONS=users,companies,stakeholders,transactions,documents,financialmetrics
CHANGESTREAM_BATCH_SIZE=100
CHANGESTREAM_MAX_AWAIT_TIME_MS=1000
CHANGESTREAM_FULL_DOCUMENT=updateLookup

# Resume token persistence
SYNC_RESUME_TOKEN_PERSISTENCE=true
SYNC_RESUME_TOKEN_PATH=./data/change-stream-tokens.json

# Dead letter queue configuration
SYNC_DLQ_PATH=./data/sync-dlq.json
SYNC_MAX_DLQ_SIZE=1000

# Change stream reconnection
SYNC_RECONNECT_DELAY_MS=5000
SYNC_MAX_RECONNECT_DELAY_MS=60000

# ZeroDB Sync Settings (ZeroDB → MongoDB)
ZERODB_SYNC_ENABLED=false
SYNC_CONFLICT_STRATEGY=last-write-wins
# Options: 'last-write-wins', 'mongodb-priority', 'zerodb-priority', 'custom'
SYNC_POLL_INTERVAL_MS=5000
SYNC_STATE_COLLECTION=sync_metadata

# Retry and Backoff Configuration
SYNC_BASE_BACKOFF_MS=1000
SYNC_MAX_BACKOFF_MS=30000

# Database Monitoring
ENABLE_DB_MONITORING=false

# Server Configuration
PORT=3001
NODE_ENV=development

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=24h

# Shortcut API Configuration
SHORTCUT_API_TOKEN=your_shortcut_api_token_here


# API Keys (if applicable)
# API_KEY=your_api_key_here

# Third-party Service Configuration
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-west-2

# Email Configuration (if applicable)
EMAIL_SERVICE=mailgun
EMAIL_API_KEY=your_email_service_api_key_here
# EMAIL_DOMAIN=mail.your-domain.com
# EMAIL_FROM=noreply@your-domain.com

# Logging
LOG_LEVEL=info
