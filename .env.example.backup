# OpenCap Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# ZERODB CONFIGURATION (Primary Database)
# ============================================================================
# ZeroDB is the primary database for OpenCap platform
# Get your API key from https://ainative.studio
ZERODB_API_KEY=your_zerodb_api_key_here
ZERODB_BASE_URL=https://api.ainative.studio/api/v1
ZERODB_PROJECT_ID=your_project_id_here

# Alternative: Use AINATIVE_API_TOKEN for authentication
AINATIVE_API_TOKEN=your_ainative_api_token_here

# Enable ZeroDB features
ENABLE_ZERODB=true

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3001
NODE_ENV=development

# ============================================================================
# AUTHENTICATION
# ============================================================================
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=24h

# ============================================================================
# SHORTCUT API CONFIGURATION
# ============================================================================
SHORTCUT_API_TOKEN=your_shortcut_api_token_here

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
EMAIL_SERVICE=mailgun
EMAIL_API_KEY=your_email_service_api_key_here
# EMAIL_DOMAIN=mail.your-domain.com
# EMAIL_FROM=noreply@your-domain.com

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# THIRD-PARTY SERVICES (Optional)
# ============================================================================
# AWS Configuration
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-west-2

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# - MongoDB has been removed in favor of ZeroDB
# - ZeroDB provides NoSQL, PostgreSQL, Vector, and Event Stream capabilities
# - Ensure ZERODB_API_KEY or AINATIVE_API_TOKEN is set for production
# - Visit https://ainative.studio for ZeroDB setup and configuration
