{
  "schema_version": "1.0",
  "agent_card_version": "1.0",
  "name": "OpenCap Stack",
  "short_description": "Cap table & equity management for startups",
  "long_description": "OpenCap Stack is an open-source financial management platform for startup equity. Track stakeholders, issue shares and options, manage SAFE notes, run 409A valuations, and generate investor-ready reports — all via a REST API aligned with the Open Cap Table Alliance (OCTA) schema.",
  "logo": "https://opencapstack.com/logo.png",
  "url": "https://opencapstack.com",
  "category": "finance",
  "tags": ["cap-table", "equity", "startup", "finance", "SAFE", "409A", "OCTA", "investor-relations"],
  "pricing": {
    "model": "open-source",
    "free_tier": true
  },
  "api": {
    "openapi_url": "https://opencapstack.com/openapi.json",
    "base_url": "https://opencapstack.com/api/v1",
    "auth_type": "bearer_jwt"
  },
  "agent_onboarding": {
    "supported": true,
    "endpoint": "https://opencapstack.com/api/v1/agents/onboard",
    "human_steps_required": 0,
    "description": "POST agent_id + capabilities, receive JWT immediately"
  },
  "actions": [
    { "name": "list_stakeholders", "method": "GET", "path": "/stakeholders" },
    { "name": "create_stakeholder", "method": "POST", "path": "/stakeholders" },
    { "name": "list_share_classes", "method": "GET", "path": "/share-classes" },
    { "name": "list_equity_grants", "method": "GET", "path": "/equity-grants" },
    { "name": "create_safe_note", "method": "POST", "path": "/safe-notes" },
    { "name": "get_409a_valuation", "method": "GET", "path": "/valuations/409a" },
    { "name": "simulate_dilution", "method": "POST", "path": "/dilution/simulate" },
    { "name": "generate_report", "method": "POST", "path": "/reports/generate" }
  ],
  "data_schemas": {
    "standard": "OCTA v2.0",
    "schema_url": "https://opencapstack.com/api/v1/schema"
  }
}
