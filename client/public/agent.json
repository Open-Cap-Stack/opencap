{
  "schema_version": "1.0",
  "name": "OpenCap Stack",
  "description": "Open-source cap table and equity management platform. Manages stakeholders, share classes, equity grants, SAFE notes, 409A valuations, and financial reporting aligned with OCTA schema.",
  "url": "https://opencapstack.com",
  "api": {
    "type": "openapi",
    "url": "https://opencapstack.com/openapi.json",
    "base_url": "https://opencapstack.com/api/v1"
  },
  "auth": {
    "type": "bearer",
    "registration_endpoint": "https://opencapstack.com/api/v1/auth/register",
    "agent_onboarding_endpoint": "https://opencapstack.com/api/v1/agents/onboard",
    "token_endpoint": "https://opencapstack.com/api/v1/auth/login",
    "zero_human_onboarding": true
  },
  "capabilities": [
    "cap-table-management",
    "equity-issuance",
    "safe-notes",
    "409a-valuations",
    "investor-reporting",
    "document-management",
    "dilution-modeling",
    "stakeholder-management"
  ],
  "contact": {
    "support": "https://opencapstack.com/support",
    "docs": "https://opencapstack.com/api-docs",
    "github": "https://github.com/Open-Cap-Stack/opencapstack"
  },
  "discovery": {
    "llms_txt": "https://opencapstack.com/llms.txt",
    "llms_full_txt": "https://opencapstack.com/llms-full.txt",
    "agents_md": "https://opencapstack.com/AGENTS.md",
    "sitemap": "https://opencapstack.com/sitemap.xml"
  }
}
