# ─── Next.js Client Environment Variables ────────────────────────────────────
# Copy this file to .env.local and fill in your values.

# Google Analytics 4 Measurement ID
# How to get it:
#   1. Go to https://analytics.google.com
#   2. Admin → Property → Create Property (choose "Web")
#   3. Enter your site URL (e.g. https://opencapstack.com)
#   4. Go to Data Streams → your stream → copy the Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KYCXJ4D8M8

# Public site URL (used for canonical URLs and OG metadata)
NEXT_PUBLIC_SITE_URL=https://opencapstack.com

# Backend API URL (default: proxied via next.config.js rewrites)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
