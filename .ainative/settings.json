{
  "$schema": "https://google-gemini.github.io/gemini-cli/schemas/settings.schema.json",
  "version": "1.0.0",
  "project": {
    "name": "OpenCap Stack",
    "type": "web-application",
    "framework": "express",
    "language": "javascript",
    "description": "MERN stack application for equity management aligned with OCTA schema"
  },
  "paths": {
    "root": "/Users/juweriya/Desktop/opencapstack",
    "include_directories": [
      "controllers",
      "models",
      "routes",
      "services",
      "middleware",
      "config",
      "tests",
      "e2e",
      "scripts"
    ],
    "exclude_patterns": [
      "node_modules",
      "dist",
      "build",
      "coverage",
      ".git",
      "frontend/node_modules",
      "frontend/dist"
    ]
  },
  "context": {
    "primary_context_file": ".ainative/AINATIVE.md",
    "supplementary_files": [
      "CLAUDE.md",
      "README.md",
      "docs/DataModels.md",
      "docs/API_Documentation_Sprint1.md"
    ],
    "max_context_files": 10
  },
  "model": {
    "default": "gemini-2.5-pro",
    "context_window": "1M",
    "temperature": 0.7,
    "tool_output_summarization": true
  },
  "tools": {
    "enabled": [
      "file_read",
      "file_write",
      "shell",
      "web_fetch",
      "memory"
    ],
    "shell": {
      "allowed_commands": [
        "npm",
        "git",
        "node",
        "npx",
        "curl",
        "grep",
        "find",
        "docker",
        "docker-compose",
        "mongosh"
      ],
      "working_directory": "/Users/juweriya/Desktop/opencapstack"
    }
  },
  "security": {
    "trusted_folders": [
      "/Users/juweriya/Desktop/opencapstack"
    ],
    "sandbox_profile": "default"
  },
  "ui": {
    "theme": "dark",
    "show_citations": true,
    "show_line_numbers": true
  },
  "privacy": {
    "collect_usage_stats": false
  },
  "extensions": {
    "mcp_servers": {
      "zerodb": {
        "enabled": true,
        "description": "ZeroDB vector database and embeddings"
      },
      "github": {
        "enabled": true,
        "description": "GitHub API integration"
      }
    }
  },
  "ai_coding_rules": {
    "git_attribution": {
      "rule": "ZERO_TOLERANCE",
      "description": "NEVER include AI tool attribution in commits, PRs, or issues",
      "forbidden_terms": [
        "Claude",
        "Anthropic",
        "claude.com",
        "Generated with Claude",
        "Co-Authored-By: Claude",
        "Gemini",
        "AI-generated",
        "Generated with"
      ]
    },
    "commit_style": {
      "format": "conventional",
      "examples": [
        "feat: Add stakeholder CRUD endpoints",
        "fix: Resolve share class validation error",
        "docs: Update API documentation",
        "test: Add unit tests for equity simulation",
        "chore: Update dependencies",
        "refactor: Simplify authentication flow"
      ]
    },
    "branch_naming": {
      "format": "{type}/{story-id}-{slug}",
      "types": ["feature", "bug", "chore"],
      "story_prefixes": ["OCAE", "OCDI", "OCSIS"]
    },
    "code_quality": {
      "linting": "required",
      "testing": "required_for_features",
      "min_coverage": 80
    }
  },
  "development": {
    "port": 5000,
    "auto_restart": true,
    "hot_reload": true,
    "source_maps": true
  },
  "testing": {
    "framework": "jest",
    "e2e_framework": "playwright",
    "commands": {
      "unit": "npm test",
      "coverage": "npm run test:coverage",
      "e2e": "npm run test:e2e",
      "all": "npm run test:all"
    }
  },
  "databases": {
    "primary": {
      "type": "mongodb",
      "default_uri": "mongodb://localhost:27017/opencap"
    },
    "analytics": {
      "type": "postgresql",
      "description": "For analytics and reporting"
    },
    "graph": {
      "type": "neo4j",
      "description": "For relationship graphs"
    }
  }
}
